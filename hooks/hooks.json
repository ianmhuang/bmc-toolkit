{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/install_deps.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/install_deps.py\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/bmc-spec/scripts/bmcspec.py\" notes record || python3 \"${CLAUDE_PLUGIN_ROOT}/skills/bmc-spec/scripts/bmcspec.py\" notes record"
                    }
                ]
            }
        ]
    }
}
